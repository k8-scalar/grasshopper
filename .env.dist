# .env.dist

# The authentication URL for your OpenStack environment
OS_AUTH_URL=https://hera.cs.kuleuven.be:5000

# The authentication type (e.g., password, application_credentials)
OS_AUTH_TYPE=v3applicationcredential

# The identity API version (typically v3)
OS_IDENTITY_API_VERSION=3

# The region name in your OpenStack environment
OS_REGION_NAME=RegionOne

# The interface to use for OpenStack (e.g., public, internal, admin)
OS_INTERFACE=public

# The application credential ID from OpenStack Horizon
OS_APPLICATION_CREDENTIAL_ID=your-application-credential-id

# The application credential secret from OpenStack Horizon
OS_APPLICATION_CREDENTIAL_SECRET=your-application-credential-secret

# The Neutron (network) API endpoint
OS_NEUTRON_ENDPOINT="https://hera.cs.kuleuven.be:9696"

# The Nova (compute) API endpoint
OS_NOVA_ENDPOINT="https://hera.cs.kuleuven.be:8774/v2.1"

# --- Multi-domain (nodes spanning multiple OpenStack projects) ---
# If your k8s cluster's nodes belong to more than one OpenStack project, set
# OS_PROJECTS_JSON instead of (or in addition to - see below) the flat OS_*
# vars above. It's a JSON list of per-project credential sets, each shaped
# like the flat vars above. Label each k8s Node with
# grasshopper.io/openstack-project=<key> to say which project it belongs to;
# unlabeled nodes are assumed to be in the "default" project.
#
# If OS_PROJECTS_JSON is unset, the flat OS_* vars above are used as a single
# implicit "default" project - existing single-project deployments need no
# changes at all. If OS_PROJECTS_JSON IS set but has no "default" entry, the
# flat vars above still fill in that gap.
#
# OS_PROJECTS_JSON=[
#   {
#     "key": "default",
#     "auth_url": "https://hera.cs.kuleuven.be:5000",
#     "application_credential_id": "...",
#     "application_credential_secret": "...",
#     "neutron_endpoint": "https://hera.cs.kuleuven.be:9696",
#     "nova_endpoint": "https://hera.cs.kuleuven.be:8774/v2.1"
#   },
#   {
#     "key": "project-b",
#     "auth_url": "https://project-b.cs.kuleuven.be:5000",
#     "application_credential_id": "...",
#     "application_credential_secret": "...",
#     "neutron_endpoint": "https://project-b.cs.kuleuven.be:9696",
#     "nova_endpoint": "https://project-b.cs.kuleuven.be:8774/v2.1"
#   }
# ]

