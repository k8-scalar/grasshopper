# .env.dist

# The authentication URL for your OpenStack environment
OS_AUTH_URL=https://hera.cs.kuleuven.be:5000

# The authentication type (e.g., password, application_credentials)
OS_AUTH_TYPE=v3applicationcredential

# The identity API version (typically v3)
OS_IDENTITY_API_VERSION=3

# The region name in your OpenStack environment
OS_REGION_NAME=RegionOne

# The interface to use for OpenStack (e.g., public, internal, admin)
OS_INTERFACE=public

# The application credential ID from OpenStack Horizon
OS_APPLICATION_CREDENTIAL_ID=your-application-credential-id

# The application credential secret from OpenStack Horizon
OS_APPLICATION_CREDENTIAL_SECRET=your-application-credential-secret

# The Neutron (network) API endpoint
OS_NEUTRON_ENDPOINT="https://hera.cs.kuleuven.be:9696"

# The Nova (compute) API endpoint
OS_NOVA_ENDPOINT="https://hera.cs.kuleuven.be:8774/v2.1"

